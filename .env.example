# ============================================
# Strands Agents PoC Configuration Template
# ============================================
# 复制为 .env 并填入真实值。

# --- Ollama backend ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_AUTH_TOKEN=ollama

# --- Agent workspace ---
AGENT_WORKSPACE=./workspace/sample_project

# --- JSONL session log output ---
SESSION_LOG_DIR=./sessions

# --- Tool allow-list (comma-separated) ---
ALLOWED_TOOLS=read,glob,grep,write,edit

# ============================================
# OpenTelemetry -> Langfuse (self-host)
# ============================================
# Langfuse UI 地址（Strands tracer 看到这个变量就切换 span 属性模式）
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE-ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE-ME

# OTLP 导出 - 拼接方法：
#   python3 -c "import base64; print(base64.b64encode(f'{pk}:{sk}'.encode()).decode())"
# ⚠️ Langfuse 必须加 "Basic " 前缀（OTel 标准没有，Langfuse 才有）
OTEL_SERVICE_NAME=strands-poc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic REPLACE-WITH-BASE64
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental,gen_ai_tool_definitions
