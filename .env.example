# ============================================
# Strands Agents PoC Configuration
# ============================================
# Copy this file to .env and adjust values.

# --- Ollama backend ---
OLLAMA_BASE_URL=http://swiftechie.aa0.netvolante.jp:51434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_AUTH_TOKEN=ollama  # 占位，Ollama 不校验内容

# --- Agent workspace (sandbox root for write-class tools) ---
AGENT_WORKSPACE=./workspace/sample_project

# --- JSONL session log output ---
SESSION_LOG_DIR=./sessions

# --- Tool allow-list (comma-separated) ---
# Default: read-only + write/edit (sandbox-checked via BeforeToolCallEvent.cancel_tool)
ALLOWED_TOOLS=read,glob,grep,write,edit