# ============================================
# Zai Agent Configuration Template
# ============================================
# 复制为 .env 并填入真实值。

# --- Ollama backend ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_AUTH_TOKEN=ollama

# --- Agent workspace ---
AGENT_WORKSPACE=./workspace/sample_project

# --- JSONL session log output ---
SESSION_LOG_DIR=./sessions

# --- Tool allow-list (comma-separated) ---
ALLOWED_TOOLS=read,glob,grep,write,edit

# ============================================
# Execution-level Sandbox (Strands SDK Sandbox)
# ============================================
# Two enforcement layers exist:
#   1. WorkspaceSandboxHook (security.py)  — path-level, always active.
#      Vetoes tool calls whose target path is outside AGENT_WORKSPACE.
#   2. SDK Sandbox (sandbox.py)             — execution-level.
#      Provides isolation for code/shell/file ops run by tools.
#
# Modes:
#   host   — NotASandboxLocalEnvironment. No isolation. Hook layer is the
#            only enforcement. Zero deps. Default.
#   posix  — LocalBashSandbox (PosixShellSandbox subclass). Subprocess
#            isolation via local bash. Needs bash + base64 on PATH.
#   docker — DockerSandbox. Requires a RUNNING container.
#   ssh    — SshSandbox. Requires an SSH-reachable host.
EXECUTION_SANDBOX=host

# --- docker mode ---
# SANDBOX_CONTAINER=zai-sandbox
# SANDBOX_CONTAINER_WORKDIR=/workspace
# SANDBOX_CONTAINER_USER=

# --- ssh mode ---
# SANDBOX_SSH_HOST=sandbox.internal
# SANDBOX_SSH_USER=zai
# SANDBOX_SSH_PORT=22

# ============================================
# OpenTelemetry (Optional - 注释掉以禁用遥测)
# ============================================
# 如需启用 Langfuse 或其他 OTLP 兼容的追踪系统，取消注释并配置：
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# OTEL_SERVICE_NAME=zai-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic REPLACE-WITH-BASE64
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental,gen_ai_tool_definitions
